# Copie ce fichier en .env puis colle ta clé.
# ⚠️ Ne JAMAIS publier le fichier .env sur GitHub (il est dans .gitignore).
# ⚠️ Ce fichier-ci (.env.example) ne doit JAMAIS contenir une vraie clé.

# Ta clé Groq : console.groq.com → API Keys → Create API Key
GROQ_API_KEY=colle_ta_cle_ici

# Optionnel : forcer un autre modèle (voir 02_lister_modeles.py)
# MODEL=openai/gpt-oss-120b

# Optionnel : pointer vers un autre hébergeur compatible OpenAI.
# C'est la seule ligne à changer pour quitter Groq — le code ne bouge pas.
# BASE_URL=https://api.autre-hebergeur.com/v1
